<%# Link previews for X, LinkedIn, Slack, iMessage and friends. Without
    og:image and twitter:card a shared tududi.com link shows as bare text.
    Each page may pass its own `image` (a file under public/) and `imageAlt`;
    the homepage card is the default. Bump the image's number when it
    changes: X caches cards for days and only a new URL makes it fetch again. %>
<%
    const ogImage = (typeof image !== 'undefined' && image) ? image : 'og-2.png';
    const ogAlt = (typeof imageAlt !== 'undefined' && imageAlt) ? imageAlt : 'tududi: get it all out of your head';
%>
<meta property="og:type" content="website">
<meta property="og:site_name" content="tududi">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= url %>">
<meta property="og:image" content="<%= siteOrigin %>/landing-assets/<%= ogImage %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= ogAlt %>">
<meta name="twitter:card" content="summary_large_image">
