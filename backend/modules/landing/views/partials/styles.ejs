        /* ---------- Comparison ---------- */
        .compare-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        /* On a phone only ~1.5 of the four columns fit, and a table simply cut
           off at the edge reads as broken rather than scrollable. The fade is
           the affordance; JS drops it once you have reached the end. It sits on
           the wrapper, not the scroller - inside the scroller it would be
           positioned against the content and scroll away with it. */
        .compare-scroll-wrap { position: relative; }
        .compare-scroll-wrap::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            inset-inline-end: 0;
            width: 48px;
            pointer-events: none;
            opacity: 0;
            transition: opacity .2s;
            background: linear-gradient(to left, #f7f6f3, rgba(247, 246, 243, 0));
        }
        [dir="rtl"] .compare-scroll-wrap::after { background: linear-gradient(to right, #f7f6f3, rgba(247, 246, 243, 0)); }
        .compare-scroll-wrap.has-more::after { opacity: 1; }
        .compare { background: #fff; border-radius: 20px; overflow: hidden; border: 1px solid #ececee; }
        .compare-row { display: grid; grid-template-columns: minmax(0, 1.6fr) repeat(2, minmax(0, 1fr)); background: #ececee; gap: 1px; }
        .compare-row > div { background: #fff; padding: 16px; }
        .compare-head > div { background: #f7f6f3; text-align: center; font-weight: 700; color: #111827; font-size: 14.5px; }
