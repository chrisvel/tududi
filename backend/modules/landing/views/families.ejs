<!DOCTYPE html>
<html lang="<%= i18n.meta.htmlLang %>" dir="<%= i18n.meta.dir || 'ltr' %>">
<%
    const t = i18n.t;
    const personalPrice = pricing.launchActive ? pricing.annual : pricing.standard;
    const vars = {
        days: trialDays,
        proStorageGb: plans.proStorageGb,
        monthly: money(pricing.monthly * 2),
        yearly: money(personalPrice * 2),
    };

    // Structure only, the same split as the homepage: every string lives in
    // locales/<lang>/landing.json under families.*, and ids, icons and
    // screenshots stay here so a translation pass can never drop a card.
    const pains = [
        { id: 'oneHead',     icon: 'fas fa-brain' },
        { id: 'groupChat',   icon: 'fas fa-comments' },
        { id: 'tooManyApps', icon: 'fas fa-th' },
    ];

    // The order a family week actually runs. Screenshots are the homepage's,
    // from a seeded account, so every name in them is sample data.
    const weekSteps = [
        { id: 'capture', icon: 'fas fa-bolt',         img: 'capture-light.png' },
        { id: 'plan',    icon: 'fas fa-calendar-day', img: 'plan-light.png' },
        { id: 'today',   icon: 'fas fa-check-double', img: 'today-light.png' },
    ];

    const familyFeatures = [
        { id: 'partner',   icon: 'fas fa-user-plus' },
        { id: 'kids',      icon: 'fas fa-child' },
        { id: 'everyone',  icon: 'fas fa-users' },
        { id: 'chores',    icon: 'fas fa-sync-alt' },
        { id: 'habits',    icon: 'fas fa-redo-alt' },
        { id: 'lists',     icon: 'fas fa-list-check' },
        { id: 'calendars', icon: 'fas fa-calendar-alt' },
        { id: 'projects',  icon: 'fas fa-folder-open' },
        { id: 'phones',    icon: 'fas fa-mobile-alt' },
    ];

    const aiCards = [
        { id: 'fixedTimes', icon: 'fas fa-calendar-check' },
        { id: 'brief',      icon: 'fas fa-sun' },
        { id: 'wrapUp',     icon: 'fas fa-flag-checkered' },
    ];

    // Ids double as public URL fragments, so they stay out of the locales.
    const faqs = [
        { id: 'kidsEmail', anchor: 'faq-kids-email' },
        { id: 'whoPays',   anchor: 'faq-who-pays' },
        { id: 'privacy',   anchor: 'faq-privacy' },
        { id: 'trial',     anchor: 'faq-trial', answer: trialDays > 0 ? 'aTrial' : 'a' },
        { id: 'leaving',   anchor: 'faq-leaving' },
    ];
    const faqQ = (item) => t('families.faq.items.' + item.id + '.q', vars);
    const faqA = (item) => t('families.faq.items.' + item.id + '.' + (item.answer || 'a'), vars);
%>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('families.metaTitle') %></title>
    <meta name="description" content="<%= t('families.metaDescription') %>">
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <% locales.forEach(function (l) { %>
    <link rel="alternate" hreflang="<%= l.htmlLang %>" href="<%= pageUrl(l.code, '/families') %>" />
    <% }); %>
    <link rel="alternate" hreflang="x-default" href="<%= pageUrl('en', '/families') %>" />
    <%- include('partials/social-meta', { title: t('families.metaTitle'), description: t('families.metaDescription'), url: canonicalUrl }) %>
    <meta property="og:locale" content="<%= i18n.meta.ogLocale %>">
    <script type="application/ld+json"><%- jsonForScript({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        inLanguage: i18n.meta.htmlLang,
        mainEntity: faqs.map(function (item) {
            return {
                '@type': 'Question',
                '@id': canonicalUrl + '#' + item.anchor,
                name: faqQ(item),
                acceptedAnswer: { '@type': 'Answer', text: faqA(item) },
            };
        }),
    }) %></script>
    <link rel="icon" href="/landing-assets/favicon.ico">
    <%- include('partials/head-assets') %>
    <%- include('partials/styles') %>
    <style>
        .pain-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
        .pain-card { background: #fff; border-radius: 14px; padding: 28px 24px; box-shadow: 0 1px 2px rgba(17, 24, 39, 0.04); }
        .pain-card i { color: #e0645c; font-size: 20px; margin-bottom: 14px; }
        .pain-card h3 { font-size: 18px; font-weight: 700; color: #111827; margin-bottom: 8px; }
        .pain-card p { color: #4b5563; font-size: 15.5px; line-height: 1.6; }
        .pain-turn { text-align: center; font-family: 'Manrope', 'Inter', sans-serif; font-size: clamp(20px, 2.6vw, 26px); font-weight: 700; color: #111827; margin-top: 48px; }
        .family-grid { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
        @media (min-width: 960px) { .family-grid { grid-template-columns: repeat(3, 1fr); } }
        .family-price { text-align: center; color: #4b5563; font-size: 15px; margin-top: 18px; }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <section class="hero">
        <div class="hero-glow"></div>
        <div class="hero-inner">
            <div class="hero-badges">
                <span class="hero-badge hero-badge-launch">
                    <i class="fas fa-house-user"></i>
                    <span><%= t('families.hero.badge') %></span>
                </span>
            </div>
            <% const heroLine2 = t('families.hero.titleLine2'); %>
            <h1><%= t('families.hero.titleLine1') %><% if (heroLine2) { %><br><%= heroLine2 %><% } %></h1>
            <p class="hero-lede"><%= t('families.hero.lede') %></p>
            <div class="hero-actions">
                <a href="<%= appUrl %>/register" class="btn-primary"><i class="fas fa-cloud"></i><%= trialDays > 0 ? t('families.hero.ctaTrial', vars) : t('families.hero.ctaPrimary') %></a>
                <a href="#plan" class="btn-secondary"><%= t('families.hero.ctaSecondary') %></a>
            </div>
            <p class="hero-note"><i class="fas fa-cloud"></i><%= trialDays > 0 ? t('families.hero.noteTrial', vars) : t('families.hero.note') %></p>
        </div>

        <div class="browser-frame">
            <div class="browser-dots">
                <span style="background:#e0645c;"></span>
                <span style="background:#e5b95c;"></span>
                <span style="background:#61c454;"></span>
            </div>
            <video id="hero-video" class="hero-video" muted loop playsinline preload="metadata"
                   poster="/landing-assets/screenshots/hero-light.png"
                   aria-label="<%= t('families.hero.screenshotAlt') %>">
                <source src="/landing-assets/screenshots/hero.mp4" type="video/mp4">
            </video>
            <script>
                (function () {
                    var v = document.getElementById('hero-video');
                    if (!v || !window.matchMedia || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
                    v.preload = 'auto';
                    var p = v.play();
                    if (p && p.catch) p.catch(function () {});
                })();
            </script>
        </div>
    </section>

    <section class="section" style="background:#f7f6f3;">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow"><%= t('families.pains.eyebrow') %></span>
                <h2 class="section-title"><%= t('families.pains.title') %></h2>
                <p class="section-sub" style="max-width:720px; margin:0 auto;"><%= t('families.pains.sub') %></p>
            </div>
            <div class="pain-grid">
                <% pains.forEach(function (pain) { %>
                <div class="pain-card">
                    <i class="<%= pain.icon %>" aria-hidden="true"></i>
                    <h3><%= t('families.pains.items.' + pain.id + '.title') %></h3>
                    <p><%= t('families.pains.items.' + pain.id + '.body') %></p>
                </div>
                <% }); %>
            </div>
            <p class="pain-turn"><%= t('families.pains.turn') %></p>
        </div>
    </section>

    <section id="plan" class="section plan-day">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow"><%= t('families.week.eyebrow') %></span>
                <h2 class="section-title"><%= t('families.week.title') %></h2>
                <p class="section-sub" style="max-width:720px; margin:0 auto;"><%= t('families.week.sub') %></p>
            </div>
            <% weekSteps.forEach(function (step, i) { %>
            <div class="plan-step<%= i % 2 ? ' plan-step-flip' : '' %>">
                <div class="plan-step-text">
                    <span class="plan-step-num"><i class="<%= step.icon %>"></i><%= t('families.week.stepLabel', { n: i + 1 }) %></span>
                    <h3><%= t('families.week.steps.' + step.id + '.title') %></h3>
                    <p><%= t('families.week.steps.' + step.id + '.body') %></p>
                    <ul>
                        <% i18n.tList('families.week.steps.' + step.id + '.points').forEach(function (point) { %>
                        <li><i class="fas fa-check"></i><%= point %></li>
                        <% }); %>
                    </ul>
                </div>
                <div class="browser-frame plan-step-shot">
                    <div class="browser-dots">
                        <span style="background:#e0645c;"></span>
                        <span style="background:#e5b95c;"></span>
                        <span style="background:#61c454;"></span>
                    </div>
                    <img src="/landing-assets/screenshots/<%= step.img %>" alt="<%= t('families.week.steps.' + step.id + '.alt') %>" loading="lazy">
                </div>
            </div>
            <% }); %>
        </div>
    </section>

    <section id="features" class="section features">
        <div class="container">
            <div class="section-head" style="margin-bottom:72px;">
                <span class="eyebrow"><%= t('families.features.eyebrow') %></span>
                <h2 class="section-title"><%= t('families.features.title') %></h2>
                <p class="section-sub" style="max-width:720px; margin:0 auto;"><%= t('families.features.sub') %></p>
            </div>
            <div class="feature-grid family-grid">
                <% familyFeatures.forEach(function (card) { %>
                <div class="feature-card">
                    <div class="feature-icon"><i class="<%= card.icon %>"></i></div>
                    <h4><%= t('families.features.cards.' + card.id + '.title') %></h4>
                    <p><%= t('families.features.cards.' + card.id + '.body') %></p>
                </div>
                <% }); %>
            </div>
        </div>
    </section>

    <section id="ai" class="section section-dark">
        <div class="container-md">
            <div class="ai-kicker">
                <span class="ai-kicker-icon"><i class="fas fa-wand-magic-sparkles"></i></span>
                <span class="ai-kicker-label"><%= t('families.ai.kicker') %></span>
            </div>
            <h2 class="ai-title"><%= t('families.ai.titleLine1') %><br><%= t('families.ai.titleLine2') %></h2>
            <p class="ai-lede"><%= t('families.ai.lede') %></p>
            <div class="auto-grid">
                <% aiCards.forEach(function (card) { %>
                <div class="dark-card">
                    <i class="<%= card.icon %>"></i>
                    <h4><%= t('families.ai.cards.' + card.id + '.title') %></h4>
                    <p><%= t('families.ai.cards.' + card.id + '.body') %></p>
                </div>
                <% }); %>
            </div>
        </div>
    </section>

    <section id="pricing" class="section" style="background:#f7f6f3;">
        <div class="container-sm">
            <div class="section-head">
                <span class="eyebrow"><%= t('families.pricing.eyebrow') %></span>
                <h2 class="section-title"><%= t('families.pricing.title') %></h2>
                <p class="section-sub"><%= t('families.pricing.sub') %></p>
            </div>

            <div class="plan-grid" style="grid-template-columns:minmax(0,1fr); max-width:520px; margin:0 auto;">
                <div class="plan plan-featured">
                    <div class="plan-head">
                        <div class="plan-icon"><i class="fas fa-cloud"></i></div>
                        <h3><%= t('pricing.plans.cloud.name') %></h3>
                    </div>
                    <%# Same numbers as the homepage card, from the same config,
                        so the two pages cannot quote different prices. %>
                    <div class="plan-price">
                        <div class="plan-amount">
                            <span><%= money(pricing.monthly) %></span>
                            <span><%= t('pricing.perMonth') %></span>
                        </div>
                        <div class="plan-pro-line">
                            <span class="plan-pro-sep"><%= t('families.pricing.or') %></span>
                            <strong><%= money(personalPrice) %></strong><%= t('pricing.perYear') %>
                            <% if (pricing.launchActive) { %>
                            <span class="plan-tag"><%= t('pricing.earlyBird') %></span>
                            <% } %>
                        </div>
                        <div class="plan-price-note"><%= trialDays > 0 ? t('families.pricing.priceNoteTrial', vars) : t('families.pricing.priceNote') %></div>
                    </div>
                    <ul class="plan-features">
                        <% i18n.tList('families.pricing.features', vars).forEach(function (feature) { %>
                        <li><i class="fas fa-check"></i><%= feature %></li>
                        <% }); %>
                    </ul>
                    <a href="<%= appUrl %>/register" class="plan-action plan-action-primary"><%= trialDays > 0 ? t('families.pricing.actionTrial') : t('families.pricing.action') %></a>
                </div>
            </div>
            <p class="family-price"><%= t('families.pricing.twoParents', vars) %></p>
            <p class="plan-fineprint" style="text-align:center; margin-top:12px;"><%= t('pricing.fineprint') %></p>
        </div>
    </section>

    <section id="faq" class="section faq">
        <div class="container-sm">
            <div class="section-head" style="margin-bottom:48px;">
                <span class="eyebrow"><%= t('families.faq.eyebrow') %></span>
                <h2 class="section-title" style="margin-bottom:16px;"><%= t('families.faq.title') %></h2>
            </div>
            <div class="faq-list">
                <% faqs.forEach(function (item, i) { %>
                <details class="faq-item" id="<%= item.anchor %>"<%= i === 0 ? ' open' : '' %>>
                    <summary class="faq-q"><h4><%= faqQ(item) %></h4></summary>
                    <div class="faq-a">
                        <p><%= faqA(item) %></p>
                    </div>
                </details>
                <% }); %>
            </div>
        </div>
    </section>

    <section class="section" style="padding-top:72px; padding-bottom:72px;">
        <div class="container-sm">
            <div class="closing" style="margin-top:0;">
                <h2 class="section-title" style="font-size:32px; margin-bottom:14px;"><%= t('families.closing.title') %></h2>
                <p><%= t('families.closing.sub') %></p>
                <div class="closing-actions">
                    <a href="<%= appUrl %>/register" class="btn-primary"><i class="fas fa-cloud"></i><%= trialDays > 0 ? t('families.closing.primaryTrial') : t('families.closing.primary') %></a>
                    <a href="<%= localePath(i18n.locale) %>" class="btn-secondary"><%= t('families.closing.secondary') %></a>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>

    <script>
        // The nav toggle, the same behaviour as the homepage's, minus the
        // parts for widgets this page does not have.
        (function () {
            const navToggle = document.getElementById('nav-toggle');
            const navMobile = document.getElementById('nav-mobile');
            if (!navToggle || !navMobile) return;
            function setNavOpen(open) {
                navMobile.classList.toggle('open', open);
                navToggle.setAttribute('aria-expanded', String(open));
                navToggle.querySelector('i').className = open ? 'fas fa-times' : 'fas fa-bars';
            }
            navToggle.addEventListener('click', () => setNavOpen(!navMobile.classList.contains('open')));
            navMobile.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setNavOpen(false)));
            document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setNavOpen(false); });
            window.addEventListener('resize', () => { if (window.innerWidth > 1180) setNavOpen(false); });
        })();
    </script>
</body>
</html>
