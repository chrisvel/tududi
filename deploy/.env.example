# Life-to-Day deployment environment. The same variables work on every host:
#
#   VPS with compose:  cp .env.example .env && chmod 600 .env
#   Runflare / PaaS:   enter each variable in the service's environment
#                      settings (secrets as Secret); skip LTD_DOMAIN.
#
# Values here are secrets: they stay on the host or in the platform panel and
# are never committed (.gitignore and .dockerignore already exclude .env).
# Only variables the app or compose actually read are listed; optional
# features (email, OIDC, CalDAV, AI) are in the repository's root .env.example.

# ---------------------------------------------------------------------------
# Domain (compose + Caddy only; a PaaS sets the domain in its own panel)
# ---------------------------------------------------------------------------

# Public hostname. Its A record must point at this server.
LTD_DOMAIN=plan.example.com

# Local default: same app service built here, no Caddy. On the production
# host set COMPOSE_FILE=docker-compose.yml and use --profile production.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
LTD_VERSION=latest

# ---------------------------------------------------------------------------
# Admin account and session
# ---------------------------------------------------------------------------

# Created on the first start. Once the user exists, later starts leave its
# password alone; change it in the app instead.
TUDUDI_USER_EMAIL=you@example.com
# Long random password, e.g.: openssl rand -base64 24
TUDUDI_USER_PASSWORD=<replace-with-a-long-random-password>

# Signs session cookies and derives the key that encrypts stored secrets
# (calendar feed addresses, AI keys). Without it every restart signs
# everyone out. Generate once and keep it: openssl rand -hex 64
TUDUDI_SESSION_SECRET=<replace-with-output-of-openssl-rand-hex-64>

# ---------------------------------------------------------------------------
# Public address and reverse proxy
# ---------------------------------------------------------------------------

# Must be https:// plus the same domain as LTD_DOMAIN.
TUDUDI_ALLOWED_ORIGINS=https://plan.example.com

# Address users open; used for links in emails and OAuth/OIDC metadata.
BASE_URL=https://plan.example.com

# Number of proxy hops in front of the app: 1 for Caddy, and the starting
# value on a PaaS. With it the app reads https and the client IP from
# X-Forwarded-*, and the session cookie gets the Secure flag.
TUDUDI_TRUST_PROXY=1

# Adds CSP upgrade-insecure-requests. Correct only once the domain is served
# over HTTPS (Caddy, or the platform's certificate); on plain HTTP it gives a
# blank page.
UPGRADE_INSECURE_REQUESTS=true

# ---------------------------------------------------------------------------
# Storage and file ownership
# ---------------------------------------------------------------------------

# Container-side upload path; matches the ./data/uploads mount.
TUDUDI_UPLOAD_PATH=/app/uploads

# User the app runs as. The entrypoint chowns the mounted folders to this
# UID/GID and drops privileges to it. On a VPS: id -u / id -g. On a PaaS the
# defaults are fine.
PUID=1001
PGID=1001

# Optional off-site backup and dead-man credentials. Supply only on the host.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
HEALTHCHECK_URL=
